{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PixoDossiers",
  "version": "1.0.0",
  "identifier": "com.pixo.dossiers",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pixo et les Dossiers",
        "width": 1100,
        "height": 800,
        "minWidth": 820,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../payload/*": "payload/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
